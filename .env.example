# Copy to .env (gitignored) and fill in real values. Never commit real tokens.
# Get these values from Dynatrace: QuickStart -> Add data -> OpenTelemetry -> .NET.
OTEL_SERVICE_NAME=logo-2026-restapi
DT_OTLP_ENDPOINT=https://YOUR_ENVIRONMENT.live.dynatrace.com/api/v2/otlp
DT_OTLP_HEADERS=Authorization=Api-Token%20YOUR_API_TOKEN
DT_API_URL=https://YOUR_ENVIRONMENT.live.dynatrace.com
